# Copy this file to ".env" (in this same webapp/ folder) and fill in your real key.
# ".env" itself is gitignored — it never gets committed.
#
# Get your Private API Key at: https://app.roboflow.com/settings/api
# (the "Private" key, not "Publishable" — see README.md for why)

ROBOFLOW_API_KEY=rf_xxxxxxxxxxxx
